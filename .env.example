# সার্ভার
PORT=3000
NODE_ENV=development

# JWT সিক্রেট — প্রোডাকশনে অবশ্যই শক্তিশালী র‍্যান্ডম মান দিন
JWT_SECRET=change-this-to-a-long-random-secret

# ডেটাবেস
# লোকাল ডেভেলপমেন্টে embedded PostgreSQL ব্যবহার হবে (পোর্ট ৫৪৩৩)
# ক্লাউডে Neon/Render-এর কানেকশন স্ট্রিং দিন, যেমন:
# DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require
DATABASE_URL=

# প্রাথমিক সুপার অ্যাডমিন (প্রথম ইনিশিয়ালাইজে তৈরি হবে)
ADMIN_EMAIL=admin@dailyhisab.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=সুপার অ্যাডমিন

# কুকির জন্য (প্রোডাকশনে true)
COOKIE_SECURE=false
