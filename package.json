{
  "name": "daily-hisab",
  "version": "1.0.0",
  "private": true,
  "description": "Daily Hisab — দৈনিক বাজার হিসাব ব্যবস্থাপনা ওয়েবসাইট",
  "main": "server/index.js",
  "scripts": {
    "db": "node scripts/dev-db.js",
    "seed:demo": "node scripts/seed-demo.js",
    "dev": "node --watch server/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js",
    "db:init": "node server/init-db.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "embedded-postgres": "17.12.0-beta.19"
  }
}
